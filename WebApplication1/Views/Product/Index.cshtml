@using WebApplication1.Dtos
@model List<ProductReturnDto>

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold">
            Products
        </h2>

        <a asp-action="Create"
           class="btn btn-success">
            + Create Product
        </a>

    </div>

    <div class="row">

        @foreach (var product in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body d-flex flex-column">

                        <div class="mb-3 d-flex justify-content-between align-items-center">

                            <span class="badge bg-dark px-3 py-2">
                                @product.CategoryName
                            </span>

                            <small class="text-muted">
                                #@product.Id
                            </small>

                        </div>

                        <h4 class="fw-bold mb-3">
                            @product.Name
                        </h4>

                        <p class="text-muted flex-grow-1">
                            @product.Description
                        </p>

                        <h5 class="text-success fw-bold mb-3">
                            $@product.Price
                        </h5>

                        @if (product.ProductColors != null && product.ProductColors.Any())
                        {
                            <div class="mb-4">

                                <h6 class="fw-semibold mb-2">
                                    Available Colors
                                </h6>

                                <div class="d-flex flex-wrap gap-2">

                                    @foreach (var color in product.ProductColors)
                                    {
                                        <span class="badge rounded-pill bg-secondary px-3 py-2">
                                            @color.ColorName
                                        </span>
                                    }

                                </div>

                            </div>
                        }

                        <div class="mt-auto d-flex gap-2">

                            <a asp-action="Detail"
                               asp-route-id="@product.Id"
                               class="btn btn-dark flex-fill">
                                Detail
                            </a>

                            <a asp-action="Update"
                               asp-route-id="@product.Id"
                               class="btn btn-warning flex-fill">
                                Update
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@product.Id"
                               class="btn btn-danger flex-fill">
                                Delete
                            </a>

                        </div>

                    </div>

                    <div class="card-footer bg-white border-0 text-muted small px-3 pb-3">

                        Created:
                        @product.CreatedDate.ToShortDateString()

                    </div>

                </div>

            </div>
        }

    </div>

</div>